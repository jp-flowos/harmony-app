# ============================================
# Harmony App - 환경변수 목록
# .env.local 에 복사하여 사용
# ============================================

# --- 필수 (Required) ---

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Kakao OAuth (configured in Supabase dashboard, not env)
# Redirect URL: <APP_URL>/api/auth/callback

# Database (Supabase/PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- 선택 (Optional) ---

# Site URL (for SEO/OG)
NEXT_PUBLIC_SITE_URL=https://harmony-app.kr

# 카카오맵
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 공유 SDK (온보딩 "자녀에게 알리기")
NEXT_PUBLIC_KAKAO_JS_KEY=

# 운영자 정보 (온보딩 운영자 카드 + 카카오 채널)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_KAKAO_CHANNEL_URL=
NEXT_PUBLIC_OPERATOR_AVATAR_URL=

# 독립 시니어 시스템 랩 (관리자 대시보드 외부 링크)
NEXT_PUBLIC_HARMONY_SYSTEM_LAB_URL=https://harmony-system-lab.vercel.app

# 토스페이먼츠 (구독 결제)
TOSS_PAYMENTS_SECRET_KEY=
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=

# 푸시 알림 (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@harmony-app.kr

# Gemini AI (운세/콘텐츠 자동생성)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 관리자 (콤마 구분, 예: admin@example.com,jp@flowos.work)
ADMIN_EMAILS=

# 온보딩 "문의하기" mailto 주소 — 미설정 시 링크 미노출
NEXT_PUBLIC_SUPPORT_EMAIL=
